# 152-ФЗ Шифрование локального хранилища (AES-256-GCM: 32 байта hex = 64 hex-символа)
# Сгенерировать: openssl rand -hex 32
STORE_ENCRYPTION_KEY=

# Пароль главного администратора (при чистом старте/деплое)
ADMIN_PASSWORD=admin123

# Yandex Cloud (Авторизованный ключ сервисного аккаунта для IAM токенов и SpeechKit)
YC_FOLDER_ID=
YC_API_KEY=
YC_SERVICE_ACCOUNT_KEY_FILE=/app/keys/authorized_key.json

# Yandex Object Storage (бакет для временного размещения длинных аудиозаписей SpeechKit >= 1MB)
# Используется только для SpeechKit и удаляется сразу после распознавания
YC_STORAGE_BUCKET=
YC_STORAGE_ACCESS_KEY=
YC_STORAGE_SECRET_KEY=
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_REGION=ru-central1

# S3 Timeweb Cloud — изолированное резервное хранилище базы данных (AES-256-GCM зашифровано, 152-ФЗ)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_KEY_PREFIX=fls/data/
S3_REGION=ru-1
S3_SYNC_INTERVAL_SEC=300

# GigaChat (Сбер) — Авторизационные данные (Base64 Client ID + Client Secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_CREDENTIALS=
# Допустимые модели: GigaChat:Lite, GigaChat:Pro, GigaChat:Max, GigaChat:Ultra
GIGACHAT_MODEL=GigaChat:Lite
# Scope: GIGACHAT_API_PERS (физлица) или GIGACHAT_API_B2B (юрлица / ИП)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Мегафон ВАТС
MEGAFON_TOKEN=

# ВКонтакте (Оповещения управляющего, 152-ФЗ обезличенные)
VK_TOKEN=
VK_CHAT_ID=

# YClients (CRM салона Лик 28)
YCLIENTS_USER_TOKEN=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_SALON_ID=

# Порт приложения
PORT=3000
HOST=0.0.0.0

# 152-ФЗ Регламентные сроки хранения (в днях, по умолчанию 30 дней)
TTL_LOG_DAYS=30
TTL_TEMP_DAYS=30
TTL_AUDIO_DAYS=30
